# ---- Nothing from BMW goes in this repository -------------------------------------------------------------------------
# Environments are built from your own PSdZData/SWFL files: images, snapshots, saved state, SSH keys (private) and logs.
/environments/
# Images and caches built from firmware (CIC, iDrive 7 and 8) and the extracted coding dictionaries.
/cic/
/mgu7/
/mgu22/
# Compiled binaries: custom QEMU builds (GPL), glhost renderers and the decompiled shader dump. Rebuild with tools/qemu/build.sh and src/*/build.sh.
/bin/
/mapcache/
# Type-key table read from your PSdZData (VIN decoder) and other local caches
/cache/
/vendor/
# Build outputs in src/: they include libraries copied from the firmware (libc.so.3, libc.so.6, libsocket.so.3...) used only to link the shims.
/src/*/out/
/src/shim/lib/
/idemu/shim/lib-*/
/src/glhost/glhost
# Copied from the firmware at build time (mgu7.build) / look-and-feel assets taken from the BMW HMI
/tools/mgu/rse_overlay/usr/lib/idemu/libdl.so.2
/idemu/web/themes/nbt_*
# Local configuration (contains the path to your PSdZData)
/settings.json
# Generated at run time (self-signed TLS key and certificate for the phone link)
/idemu/data/phone/
# ---- Provenance not verified: photos of car interiors and screenshots of the BMW HMI ----------------------------------
# Remove these lines only if you own the rights to the images.
/idemu/web/bezel*.jpg
/docs/*.png

# ---- Tooling ----------------------------------------------------------------------------------------------------------
node_modules/
__pycache__/
*.pyc
.DS_Store
*.log
*.new
